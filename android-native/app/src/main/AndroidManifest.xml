    <!-- Only the first-run setup and later model/pack downloads use it; answering never does (gate 6 checks this). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The header's ONLINE / OFFLINE pill. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Dictation with the on-device speech recognizer (asked the first time the mic is tapped). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The Truffle Vault's de-Googled truffle: is GrapheneOS's app store there, are Google Play services missing (TruffleVault.degoogled). -->
