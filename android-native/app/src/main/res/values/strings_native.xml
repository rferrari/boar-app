    <string name="native_tweaks_appliesRestart" formatted="false">Applies after the app restarts.</string>
    <string name="native_tweaks_adjusted" formatted="false">Adjusted for this phone: {{notes}}</string>
    <string name="native_tweaks_cpuBuild" formatted="false">CPU build</string>
    <string name="native_tweaks_cpuBuildNote" formatted="false">Which instruction set the engine runs. Auto skips the SVE build where it reads prompts slower.</string>
    <string name="native_tweaks_cpuBest" formatted="false">Engine\'s pick</string>
    <string name="native_tweaks_threads" formatted="false">Threads</string>
    <string name="native_tweaks_threadsNote" formatted="false">More threads than fast cores pulls in the slow cores and is usually slower.</string>
