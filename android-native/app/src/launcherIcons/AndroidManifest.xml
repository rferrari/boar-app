<?xml version="1.0" encoding="utf-8"?>
<!--
  Truffle Vault launcher icons, merged over the main manifest only when the flag boar.truffleLauncherIcons is on
  (app/build.gradle.kts). The launcher entry moves from MainActivity to the .Launcher alias (the original icon), so
  appearance/IconSwitcher can swap it: disabling MainActivity itself would disable every alias too. Exactly one is
  enabled. Off by default: switching the icon closes the app on MIUI and may drop the home-screen shortcut once.
-->
