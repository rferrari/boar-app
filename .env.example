# Copy to .env and fill in. Expo builds EXPO_PUBLIC_* values into the app, so only put
# values here that are meant to be public, like a Supabase publishable key (never a secret key).

# Supabase project that receives shared evaluation results (supabase/README.md).
# Leave empty to build the app without the "Share results" button.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Native app (android-native) only. true adds Settings → Advanced tweaks → Debug log: a local file of how
# BOAR uses the phone (memory, battery, heat, CPU speed, model loads, answer speed, crashes), off until
# the user turns it on. Without it the build has no switch and logs nothing.
ALLOW_DEBUG_LOG=

# Native app. The menu's memory and storage bars (Settings → Advanced tweaks, off by default) are available unless
# this is false; false removes the option and the bars never show.
ALLOW_DRAWER_STATS=true

# Native app. Evaluation in the side menu (for builders who run and submit evaluations). Empty: off in normal builds,
# on in EXPERIMENTAL_FEATURES builds. The screen is always reachable from Settings → Advanced tweaks.
SHOW_EVAL_IN_MENU=
