# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# release APKs (scripts/check-release-apk.sh examples)
dist/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (copy .env.example to .env)
.env
.env*.local

# MCP servers point at our own projects; each developer adds theirs
.mcp.json

# leftovers of the 1.x Expo app's prebuild in older checkouts
/ios
/android
.expo/

# model weights (the knowledge-pack builder downloads the embedding model here)
assets/models/
*.gguf

# device evaluation results (docs/DEVICE_EVALUATION.md)
eval-results/

# knowledge pack builds (scripts/build-knowledge-pack.mjs)
build/knowledge-pack/

# Raw demo recording (31 MB); the compressed copy is docs/demo/boar_demo_small.mp4
docs/demo/boar_demo.mp4

# Native binaries a lab plugin builds (scripts/build-sd-cli.sh for the image lab)
android-native/app/src/labs/plugins/*/jniLibs/

# Agent tooling set up per machine (Claude Code, the skills CLI)
.claude/
.agents/
skills-lock.json
