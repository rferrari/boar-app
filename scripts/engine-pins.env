# The exact upstream commits Boar Labs engines are built from and were tested at (X6 Pro, Oct 2026).
# Build scripts stop when a checkout is elsewhere (ALLOW_UNPINNED=1 to build anyway, e.g. to try an update).
# scripts/engine-updates.sh compares these with the creators' repos. BOAR's own llama.cpp and zstd are
# pinned as git submodules (android-native/engine/src/main/cpp), not here.
#
# name|creator's repo|commit|license
COLIBRI_PIN=ce370e87d7b623d7759b52ec2007d75fc5b0e87e    # JustVugg/colibri, Apache-2.0
BMOE_PIN=74ba18f53d308e3271a6b7dbbdaf8e59af64cdde       # Helldez/BigMoeOnEdge, Apache-2.0
# BigMoeOnEdge runs with BOAR's patch series on top (patches/bigmoeonedge on engine-optimizations, applied by
# scripts/build-native-engines.sh, which writes this marker into the checkout).
BMOE_PATCHES=02fd0b6d190da7cd
BMOE_LLAMA_PATCHES=e5e43016057e5960
SD_PIN=d637cfb935feb2254898a8f1524046c958f3df80         # leejet/stable-diffusion.cpp, MIT
